{
  "name": "wordplay-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web && npm run test --workspace=packages/engine && npm run test --workspace=apps/native",
    "test:web": "npm run test --workspace=apps/web",
    "test:engine": "npm run test --workspace=packages/engine",
    "test:native": "npm run test --workspace=apps/native",
    "lint": "npm run lint --workspace=apps/web",
    "play": "npm run play --workspace=packages/engine"
  }
}
