# Supabase Environment Variables for the native app.
# Copy this file to .env.local and fill in your actual values.
#
# Expo inlines any env var prefixed with EXPO_PUBLIC_ into the client
# bundle at build time (the RN equivalent of Vite's VITE_ prefix used in
# apps/web/.env.example) - keep these two files' values in sync, they
# point at the same Supabase project.

# Local Development (from `supabase start`, run from the repo root).
# NOTE: unlike apps/web (where the browser and the Supabase server run on
# the same machine), a physical device's `127.0.0.1` is the device itself,
# not your dev machine - for real-device testing against a local Supabase
# instance, use your machine's LAN IP instead (e.g. http://192.168.x.x:54321).
# Simulators can generally still use 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Production (replace with your actual Supabase project values)
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
